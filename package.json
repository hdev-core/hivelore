{
  "name": "hivelore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm run dev --workspace=@hivelore/web\" \"npm run dev --workspace=@hivelore/api\"",
    "dev:web": "npm run dev --workspace=@hivelore/web",
    "dev:api": "npm run dev --workspace=@hivelore/api",
    "smoke:hive-mainnet": "npm run smoke:hive-mainnet --workspace=@hivelore/api",
    "db:generate": "npm run prisma:generate --workspace=@hivelore/api",
    "db:validate": "npm run prisma:validate --workspace=@hivelore/api",
    "db:format": "npm run prisma:format --workspace=@hivelore/api",
    "db:migrate:check:fresh": "npm run prisma:migrate:check:fresh --workspace=@hivelore/api",
    "db:migrate:check:upgrade": "npm run prisma:migrate:check:upgrade --workspace=@hivelore/api",
    "db:migrate": "npm run db:migrate:dev --workspace=@hivelore/api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=@hivelore/api",
    "db:seed": "npm run db:seed --workspace=@hivelore/api",
    "db:reset": "npm run db:reset --workspace=@hivelore/api",
    "db:studio": "npm run db:studio --workspace=@hivelore/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "npm test --workspaces --if-present",
    "test:api": "npm test --workspace=@hivelore/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@next/eslint-plugin-next": "^15.4.2",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "concurrently": "^9.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@hiveio/dhive": "^1.3.6",
    "@hiveio/wax": "^2.0.2"
  }
}
