generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum LoreType {
  CHARACTER
  LOCATION
  FACTION
  QUEST
  EVENT
  STORY
  ARTIFACT
  HISTORY
  RULE
  OTHER
}

enum LoreStatus {
  DRAFT
  SUBMITTED
  APPROVED_FOR_PUBLICATION
  PUBLISHED_CANON
  ARCHIVED
}

enum ProposalType {
  ADD_LORE
  ADD_STORY
  UPDATE_LORE
  UPDATE_WORLD_BIBLE
}

enum ContributionKind {
  LORE
  STORY
}

enum ContributionStatus {
  DRAFT
  SUBMITTED
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  VOTING
  APPROVED_FOR_PUBLICATION
  REJECTED
  NEEDS_REVISION
  ALTERNATE_TIMELINE
  PUBLISHED
  WITHDRAWN
}

enum VoteChoice {
  APPROVE
  REJECT
  NEEDS_REVISION
  ALTERNATE_TIMELINE
  ABSTAIN
}

enum ProposalDecisionOutcome {
  APPROVED_FOR_PUBLICATION
  REJECTED
  NEEDS_REVISION
  ALTERNATE_TIMELINE
  STALE_BASE_CONFLICT
}

enum AIReportStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ModerationStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum ModerationTargetType {
  USER
  WORLD
  WORLD_BIBLE_VERSION
  LORE_ENTRY
  LORE_RELATIONSHIP
  PROPOSAL
  PROPOSAL_COMMENT
  APP_VOTE
  AI_REPORT
  HIVE_REFERENCE
  HIVE_EVENT
  REWARD_RECORD
}

enum HiveEntityType {
  WORLD_SEED
  WORLD_BIBLE_VERSION
  LORE_ENTRY
  STORY_CHAPTER
  CANON_DECISION
  LORE_RELATIONSHIP
  METADATA
}

enum HiveEventType {
  POST
  COMMENT
  CUSTOM_JSON
  VOTE
  REWARD
  BENEFICIARY
  OTHER
}

enum RewardType {
  AUTHOR
  CURATION
  BENEFICIARY
  OTHER
}

enum SearchEntityType {
  WORLD
  WORLD_BIBLE_VERSION
  LORE_ENTRY
  PROPOSAL
}

enum PlatformRole {
  USER
  ADMIN
}

enum WorldRole {
  READER
  CONTRIBUTOR
  FOUNDER
  CURATOR
}

enum WorldAuditAction {
  ROLE_ASSIGNED
  ROLE_CHANGED
  ROLE_REMOVED
  MODERATION_ACTION
  CANON_STATUS_EXECUTED
  AI_WARNING_RESOLVED
  CONTRIBUTION_CREATED
  CONTRIBUTION_UPDATED
  CONTRIBUTION_DELETED
  CONTRIBUTION_SUBMITTED
  PROPOSAL_CREATED
  CANON_DECISION_FINALIZED
  WORLD_BIBLE_UPDATED
  LORE_ENTRY_CREATED
  LORE_ENTRY_UPDATED
  LORE_ENTRY_DELETED
  LORE_RELATIONSHIP_CREATED
  LORE_RELATIONSHIP_DELETED
}

enum AuthProvider {
  KEYCHAIN
  HIVESIGNER
}

enum ExternalIdentityProvider {
  GOOGLE
}

enum HiveProvisioningStatus {
  PENDING
  SUCCEEDED
  FAILED
  NOT_CONFIGURED
}

enum RcDelegationStatus {
  PENDING
  SUCCEEDED
  FAILED
  NOT_CONFIGURED
}

model User {
  id                      String                    @id @default(cuid())
  hiveUsername            String                    @unique
  normalizedHiveUsername  String                    @unique
  displayName             String?
  avatarUrl               String?
  bio                     String?
  platformRole            PlatformRole              @default(USER)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  foundedWorlds           World[]                   @relation("WorldFounder")
  bibleVersions           WorldBibleVersion[]       @relation("WorldBibleVersionCreator")
  loreEntries             LoreEntry[]               @relation("LoreEntryAuthor")
  proposals               Proposal[]                @relation("ProposalAuthor")
  proposalComments        ProposalComment[]         @relation("ProposalCommentAuthor")
  deletedProposalComments ProposalComment[]         @relation("ProposalCommentDeleter")
  contributionDrafts      ContributionDraft[]       @relation("ContributionDraftAuthor")
  votes                   AppVote[]                 @relation("AppVoteVoter")
  moderationReports       ModerationReport[]        @relation("ModerationReporter")
  moderationReviews       ModerationReport[]        @relation("ModerationReviewer")
  hiveReferences          HiveReference[]           @relation("HiveReferenceAuthor")
  rewardRecords           RewardRecord[]
  rewardSummaries         UserRewardSummary[]
  reputationSnapshots     UserReputationSnapshot[]
  worldMemberships        WorldMembership[]         @relation("WorldMembershipUser")
  grantedWorldMemberships WorldMembership[]         @relation("WorldMembershipGrantor")
  worldAuditLogs          WorldAuditLog[]           @relation("WorldAuditLogActor")
  authChallenges          AuthChallenge[]
  refreshSessions         RefreshSession[]
  externalIdentityLinks   ExternalIdentityLink[]
  provisioningRequests    HiveProvisioningRequest[]
  rcDelegations           RcDelegation[]

  @@index([normalizedHiveUsername])
  @@index([platformRole])
}

model AuthChallenge {
  id                     String       @id @default(cuid())
  userId                 String?
  user                   User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  normalizedHiveUsername String
  provider               AuthProvider
  intent                 String       @default("authentication")
  challengeHash          String
  nonceHash              String
  issuedAt               DateTime
  expiresAt              DateTime
  consumedAt             DateTime?
  createdAt              DateTime     @default(now())

  @@unique([challengeHash])
  @@index([normalizedHiveUsername, provider])
  @@index([expiresAt])
  @@index([consumedAt])
  @@index([userId])
}

model RefreshSession {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionFamilyId  String
  refreshTokenHash String          @unique
  createdAt        DateTime        @default(now())
  expiresAt        DateTime
  rotatedAt        DateTime?
  revokedAt        DateTime?
  replacedById     String?         @unique
  replacedBy       RefreshSession? @relation("RefreshSessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces         RefreshSession? @relation("RefreshSessionRotation")
  lastUsedAt       DateTime?
  userAgent        String?
  ipAddress        String?

  @@index([userId])
  @@index([sessionFamilyId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AuthRateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model ExternalIdentityLink {
  id                   String                    @id @default(cuid())
  userId               String
  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             ExternalIdentityProvider
  providerSubject      String
  verifiedEmail        String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  provisioningRequests HiveProvisioningRequest[]

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@index([userId])
}

model HiveProvisioningRequest {
  id                     String                 @id @default(cuid())
  userId                 String?
  user                   User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  externalIdentityLinkId String?
  externalIdentityLink   ExternalIdentityLink?  @relation(fields: [externalIdentityLinkId], references: [id], onDelete: SetNull)
  requestedHiveUsername  String
  status                 HiveProvisioningStatus @default(NOT_CONFIGURED)
  failureReason          String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([userId])
  @@index([externalIdentityLinkId])
  @@index([status])
}

model RcDelegation {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  hiveUsername     String
  delegatorAccount String
  amount           String
  status           RcDelegationStatus @default(NOT_CONFIGURED)
  transactionId    String?
  operationIndex   Int?
  idempotencyKey   String             @unique
  failureReason    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([userId])
  @@index([hiveUsername])
  @@index([status])
}

model World {
  id                 String              @id @default(cuid())
  slug               String              @unique
  title              String
  description        String
  founderId          String
  founder            User                @relation("WorldFounder", fields: [founderId], references: [id], onDelete: Restrict)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  seed               WorldSeed?
  bibleVersions      WorldBibleVersion[]
  loreEntries        LoreEntry[]
  loreRelationships  LoreRelationship[]
  proposals          Proposal[]
  contributionDrafts ContributionDraft[]
  moderationReports  ModerationReport[]
  searchIndexes      SearchIndex[]
  memberships        WorldMembership[]
  auditLogs          WorldAuditLog[]

  @@index([founderId])
  @@index([createdAt])
}

model WorldSeed {
  id                   String   @id @default(cuid())
  worldId              String   @unique
  world                World    @relation(fields: [worldId], references: [id], onDelete: Restrict)
  premise              String
  genre                String
  tone                 String
  mainConflict         String
  startingLocation     String?
  firstCharacters      Json?
  firstFactions        Json?
  firstHistoricalEvent String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  /// Mutable off-chain world seed. Hive publication requires a future approved publication flow.

  @@index([genre])
  @@index([tone])
}

model WorldMembership {
  id          String    @id @default(cuid())
  worldId     String
  world       World     @relation(fields: [worldId], references: [id], onDelete: Restrict)
  userId      String
  user        User      @relation("WorldMembershipUser", fields: [userId], references: [id], onDelete: Restrict)
  role        WorldRole
  grantedById String?
  grantedBy   User?     @relation("WorldMembershipGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([worldId, userId])
  @@index([worldId, role])
  @@index([userId, role])
  @@index([grantedById])
  @@index([revokedAt])
}

model WorldAuditLog {
  id         String           @id @default(cuid())
  worldId    String
  world      World            @relation(fields: [worldId], references: [id], onDelete: Restrict)
  actorId    String?
  actor      User?            @relation("WorldAuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     WorldAuditAction
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime         @default(now())
  /// Append-only audit trail for role changes, moderation actions, and rule-based status execution.

  @@index([worldId, createdAt])
  @@index([actorId, createdAt])
  @@index([worldId, action, createdAt])
  @@index([targetType, targetId])
}

model WorldBibleVersion {
  id              String         @id @default(cuid())
  worldId         String
  world           World          @relation(fields: [worldId], references: [id], onDelete: Restrict)
  versionNumber   Int
  creatorId       String
  creator         User           @relation("WorldBibleVersionCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  content         Json
  changeSummary   String?
  publishedAt     DateTime?
  hiveReferenceId String?        @unique
  /// A local publishedAt value is not proof of canon; verified canon requires an indexed HiveReference.
  hiveReference   HiveReference? @relation(fields: [hiveReferenceId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  proposals       Proposal[]     @relation("ProposalResultingBibleVersion")

  @@unique([worldId, versionNumber])
  @@index([worldId, versionNumber])
  @@index([creatorId])
}

model LoreEntry {
  id                       String              @id @default(cuid())
  worldId                  String
  world                    World               @relation(fields: [worldId], references: [id], onDelete: Restrict)
  authorId                 String
  author                   User                @relation("LoreEntryAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  title                    String
  slug                     String
  loreType                 LoreType
  content                  Json
  status                   LoreStatus          @default(DRAFT)
  publishedAt              DateTime?
  hiveReferenceId          String?             @unique
  /// Published canon must be confirmed through an indexed HiveReference, not only this mutable row.
  hiveReference            HiveReference?      @relation(fields: [hiveReferenceId], references: [id], onDelete: SetNull)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  outgoingRelations        LoreRelationship[]  @relation("LoreRelationshipSource")
  incomingRelations        LoreRelationship[]  @relation("LoreRelationshipTarget")
  targetProposals          Proposal[]          @relation("ProposalTargetLoreEntry")
  targetContributionDrafts ContributionDraft[] @relation("ContributionDraftTargetLoreEntry")
  resultingProposals       Proposal[]          @relation("ProposalResultingLoreEntry")

  @@unique([worldId, slug])
  @@index([worldId, status])
  @@index([worldId, loreType])
  @@index([worldId, updatedAt, id])
  @@index([authorId])
}

model LoreRelationship {
  id           String    @id @default(cuid())
  worldId      String
  world        World     @relation(fields: [worldId], references: [id], onDelete: Restrict)
  sourceId     String
  source       LoreEntry @relation("LoreRelationshipSource", fields: [sourceId], references: [id], onDelete: Restrict)
  targetId     String
  target       LoreEntry @relation("LoreRelationshipTarget", fields: [targetId], references: [id], onDelete: Restrict)
  relationType String
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// The API must enforce sourceId != targetId and ensure both entries belong to worldId.

  @@unique([worldId, sourceId, targetId, relationType])
  @@index([worldId])
  @@index([sourceId])
  @@index([targetId])
  @@index([sourceId, updatedAt, id])
  @@index([targetId, updatedAt, id])
}

model Proposal {
  id                      String             @id @default(cuid())
  worldId                 String
  world                   World              @relation(fields: [worldId], references: [id], onDelete: Restrict)
  authorId                String
  author                  User               @relation("ProposalAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  proposalType            ProposalType
  contributionKind        ContributionKind?
  status                  ProposalStatus     @default(DRAFT)
  title                   String
  summary                 String
  proposedContent         Json
  targetLoreEntryId       String?
  targetLoreEntry         LoreEntry?         @relation("ProposalTargetLoreEntry", fields: [targetLoreEntryId], references: [id], onDelete: SetNull)
  resultingLoreEntryId    String?
  resultingLoreEntry      LoreEntry?         @relation("ProposalResultingLoreEntry", fields: [resultingLoreEntryId], references: [id], onDelete: SetNull)
  resultingBibleVersionId String?            @unique
  resultingBibleVersion   WorldBibleVersion? @relation("ProposalResultingBibleVersion", fields: [resultingBibleVersionId], references: [id], onDelete: SetNull)
  submittedAt             DateTime?
  votingStartedAt         DateTime?
  votingEndsAt            DateTime?
  decidedAt               DateTime?
  approvedAt              DateTime?
  rejectedAt              DateTime?
  publishedAt             DateTime?
  contentHash             String?
  aiWarningAcknowledgedAt DateTime?
  baseCanonVersionId      String?
  branchParentProposalId  String?
  branchBaseLoreEntryId   String?
  branchLabel             String?
  conflictMetadata        Json?
  staleBaseAtDecision     Boolean            @default(false)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  contributionDraft       ContributionDraft?
  votes                   AppVote[]
  decision                ProposalDecision?
  aiReports               AIReport[]
  moderationReports       ModerationReport[]
  comments                ProposalComment[]

  @@index([worldId, status])
  @@index([authorId])
  @@index([worldId, contributionKind])
  @@index([targetLoreEntryId])
  @@index([votingEndsAt])
  @@index([baseCanonVersionId])
  @@index([branchBaseLoreEntryId])
}

model ProposalComment {
  id          String    @id @default(cuid())
  proposalId  String
  proposal    Proposal  @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  authorId    String
  author      User      @relation("ProposalCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  body        String    @db.VarChar(3000)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("ProposalCommentDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  /// Off-chain plain-text discussion. Comments never count as AppVote rows or canon decisions.

  @@index([proposalId, createdAt, id])
  @@index([authorId, createdAt])
  @@index([deletedById])
}

model ContributionDraft {
  id                String             @id @default(cuid())
  worldId           String
  world             World              @relation(fields: [worldId], references: [id], onDelete: Cascade)
  authorId          String
  author            User               @relation("ContributionDraftAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  targetLoreEntryId String?
  targetLoreEntry   LoreEntry?         @relation("ContributionDraftTargetLoreEntry", fields: [targetLoreEntryId], references: [id], onDelete: SetNull)
  kind              ContributionKind
  title             String
  summary           String?
  content           Json
  status            ContributionStatus @default(DRAFT)
  proposalId        String?            @unique
  /// Submitted drafts are locked; Proposal.proposedContent stores the immutable reviewer snapshot.
  proposal          Proposal?          @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  submittedAt       DateTime?

  @@index([worldId])
  @@index([authorId])
  @@index([worldId, status])
  @@index([worldId, authorId, status])
  @@index([targetLoreEntryId])
}

model AppVote {
  id                    String                  @id @default(cuid())
  proposalId            String
  proposal              Proposal                @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  voterId               String
  voter                 User                    @relation("AppVoteVoter", fields: [voterId], references: [id], onDelete: Restrict)
  choice                VoteChoice
  reputationScoreAtVote Decimal?                @db.Decimal(20, 4)
  reputationSnapshotId  String?
  reputationSnapshot    UserReputationSnapshot? @relation(fields: [reputationSnapshotId], references: [id], onDelete: SetNull)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@unique([proposalId, voterId])
  @@index([proposalId])
  @@index([voterId])
}

model ProposalDecision {
  id                     String                  @id @default(cuid())
  proposalId             String                  @unique
  proposal               Proposal                @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  outcome                ProposalDecisionOutcome
  decidedAt              DateTime
  rulesVersion           String
  payloadSchemaVersion   Int
  minimumVotes           Int
  approvalThresholdBps   Int
  votingWindowHours      Int
  approveCount           Int
  rejectCount            Int
  needsRevisionCount     Int
  alternateTimelineCount Int
  totalVotes             Int
  approvalNumerator      Int
  approvalDenominator    Int
  approvalPercentageBps  Int
  aiWarningAcknowledged  Boolean                 @default(false)
  aiWarningSummary       String?
  baseCanonVersionId     String?
  branchParentProposalId String?
  branchBaseLoreEntryId  String?
  branchLabel            String?
  conflictMetadata       Json?
  staleBaseAtDecision    Boolean                 @default(false)
  contentHash            String
  decisionPayload        Json
  decisionPayloadHash    String                  @unique
  customJsonId           String?
  expectedSigner         String?
  hiveEventId            String?                 @unique
  hiveEvent              HiveEvent?              @relation(fields: [hiveEventId], references: [id], onDelete: SetNull)
  transactionId          String?
  blockNumber            BigInt?
  operationIndex         Int?
  blockchainTimestamp    DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([transactionId, operationIndex])
  @@index([outcome])
  @@index([decidedAt])
  @@index([customJsonId])
  @@index([baseCanonVersionId])
  @@index([branchBaseLoreEntryId])
}

model AIReport {
  id           String         @id @default(cuid())
  proposalId   String
  proposal     Proposal       @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  provider     String
  model        String
  status       AIReportStatus @default(PENDING)
  summary      String?
  findings     Json?
  errorCode    String?
  errorMessage String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  /// AI analysis is advisory and does not determine canon.

  @@index([proposalId])
  @@index([status])
}

model ModerationReport {
  id         String               @id @default(cuid())
  reporterId String
  reporter   User                 @relation("ModerationReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  reviewerId String?
  reviewer   User?                @relation("ModerationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  worldId    String?
  world      World?               @relation(fields: [worldId], references: [id], onDelete: SetNull)
  proposalId String?
  proposal   Proposal?            @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  targetType ModerationTargetType
  targetId   String
  reason     String
  details    String?
  status     ModerationStatus     @default(OPEN)
  reviewedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  /// Polymorphic target integrity must be enforced by API logic.

  @@index([reporterId])
  @@index([reviewerId])
  @@index([worldId, status])
  @@index([proposalId])
  @@index([targetType, targetId])
}

model HiveReference {
  id                  String             @id @default(cuid())
  entityType          HiveEntityType
  entityId            String
  hiveAuthorUsername  String
  authorId            String?
  author              User?              @relation("HiveReferenceAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  permlink            String
  transactionId       String?
  blockNumber         BigInt?
  operationIndex      Int?
  publicationMetadata Json?
  publishedAt         DateTime
  indexedAt           DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  bibleVersion        WorldBibleVersion?
  loreEntry           LoreEntry?
  rewardRecords       RewardRecord[]
  /// Hive is the immutable source of truth; this row is a verified indexed projection.

  @@unique([entityType, entityId])
  @@unique([hiveAuthorUsername, permlink])
  @@unique([transactionId, operationIndex])
  @@index([authorId])
  @@index([blockNumber])
  @@index([publishedAt])
}

model HiveEvent {
  id                  String            @id @default(cuid())
  blockNumber         BigInt
  transactionId       String
  operationIndex      Int
  eventType           HiveEventType
  blockchainTimestamp DateTime
  payload             Json
  processedAt         DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  proposalDecision    ProposalDecision?
  /// Rebuildable indexed Hive operation; the blockchain remains authoritative.

  @@unique([transactionId, operationIndex])
  @@index([blockNumber, operationIndex])
  @@index([eventType])
  @@index([blockchainTimestamp])
}

model IndexerWatermark {
  name                        String    @id
  lastProcessedBlock          BigInt    @default(0)
  lastProcessedOperationIndex Int       @default(-1)
  lastRunStartedAt            DateTime?
  lastRunFinishedAt           DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  /// Durable resume point for rebuildable indexer processes.

  @@index([lastProcessedBlock, lastProcessedOperationIndex], map: "IndexerWatermark_lastProcessedBlock_lastProcessedOperationI_idx")
}

model RewardRecord {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  hiveReferenceId String?
  hiveReference   HiveReference? @relation(fields: [hiveReferenceId], references: [id], onDelete: SetNull)
  rewardType      RewardType
  assetSymbol     String
  amount          Decimal        @db.Decimal(38, 18)
  transactionId   String
  operationIndex  Int
  blockNumber     BigInt
  payoutAt        DateTime
  idempotencyKey  String         @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  /// Indexed financial projection from Hive rewards; not the financial source of truth.

  @@index([userId, payoutAt])
  @@index([hiveReferenceId])
  @@index([blockNumber])
  @@index([transactionId, operationIndex])
}

model UserRewardSummary {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  assetSymbol      String
  totalAmount      Decimal  @db.Decimal(38, 18)
  lastCalculatedAt DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  /// Derived aggregate rebuildable from RewardRecord rows.

  @@unique([userId, assetSymbol])
  @@index([assetSymbol])
}

model UserReputationSnapshot {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  score              Decimal   @db.Decimal(20, 4)
  calculationVersion String
  breakdown          Json
  calculatedAt       DateTime  @default(now())
  createdAt          DateTime  @default(now())
  appVotes           AppVote[]
  /// Application reputation is independent of Hive native reputation.

  @@index([userId, calculatedAt])
  @@index([calculationVersion])
}

model SearchIndex {
  id                String           @id @default(cuid())
  worldId           String?
  world             World?           @relation(fields: [worldId], references: [id], onDelete: Cascade)
  entityType        SearchEntityType
  entityId          String
  title             String
  searchableContent String
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  /// Derived PostgreSQL search projection for the MVP; rebuildable from source records.

  @@unique([entityType, entityId])
  @@index([worldId, entityType])
}
