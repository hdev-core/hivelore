{
  "name": "@hivelore/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "indexer:run": "tsx src/indexer/runner.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:migrate:check:fresh": "node scripts/check-fresh-prisma-migrations.mjs",
    "prisma:migrate:check:upgrade": "node scripts/check-upgrade-prisma-migrations.mjs",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "pretest": "prisma generate",
    "test": "node scripts/run-tests.mjs",
    "pretypecheck": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prebuild": "prisma generate",
    "build": "tsc",
    "start": "node dist/server.js",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@hiveio/dhive": "^1.3.6",
    "@hiveio/wax": "^2.0.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/server": "^1.4.0",
    "dotenv": "^17.2.0",
    "fastify": "^5.4.0",
    "pg": "^8.22.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
